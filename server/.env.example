# ============================================================
# IQPREC — Environment Variables (example)
# Copy to server/.env and fill real values. NEVER commit .env.
# All secrets live here only (Pentagon L5). Zero hardcoded values.
# ============================================================

# ---- Core ----
PORT=3000
NODE_ENV=development
# The single allowed browser origin for CORS.
FRONTEND_URL=http://localhost:3000

# ---- Supabase ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- JWT (RS256 ONLY — never HS256). Use PEM key pairs. ----
# Generate:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Paste PEM contents with literal \n or wrap in quotes.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ---- Redis (rate limiting, queues) ----
REDIS_URL=redis://localhost:6379

# ---- Anthropic (Claude AI) ----
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_SEASON=price_...

# ---- Resend (transactional email / receipts) ----
RESEND_API_KEY=re_...
RESEND_FROM=IQPREC <noreply@iqprec.com>

# ---- Telegram bot ----
TELEGRAM_BOT_TOKEN=123456:ABC-...

# ---- Admin ----
ADMIN_EMAIL=admin@iqprec.com
# Comma-separated list of allowed admin IPs.
ADMIN_IP_WHITELIST=127.0.0.1
